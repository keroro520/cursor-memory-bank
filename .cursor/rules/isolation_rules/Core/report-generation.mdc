## 🔍 Data Extraction Rules

### 1. Time Range Calculation

```python
# ISO 8601 week calculation
def get_week_date_range(year, week_num):
    """
    Calculate start and end dates for a given ISO week.
    Week starts on Monday, ends on Sunday.
    """
    # Jan 4th is always in week 1
    jan4 = datetime(year, 1, 4)
    week_start = jan4 - timedelta(days=jan4.weekday())  # Monday of week 1
    target_monday = week_start + timedelta(weeks=week_num - 1)
    target_sunday = target_monday + timedelta(days=6)

    return {
        'start': target_monday.replace(hour=0, minute=0, second=0),
        'end': target_sunday.replace(hour=23, minute=59, second=59),
        'year': year,
        'week': week_num
    }

# Current week
def get_current_week():
    today = datetime.now()
    return {
        'year': today.isocalendar()[0],
        'week': today.isocalendar()[1]
    }
```

### 2. Archive File Filtering

```python
def is_task_in_range(archive_file_path, start_date, end_date):
    """
    Determine if an archived task falls within the date range.
    Priority order for date determination:
    1. Metadata "Completion Date" field
    2. Metadata "Date" field
    3. File modification time (mtime)
    """
    content = read_file(archive_file_path)

    # Try to parse metadata
    metadata = extract_metadata_section(content)

    if metadata:
        # Check for "Completion Date: YYYY-MM-DD"
        if 'completion_date' in metadata:
            task_date = parse_date(metadata['completion_date'])
            return start_date <= task_date <= end_date

        # Check for "Date: YYYY-MM-DD"
        if 'date' in metadata:
            task_date = parse_date(metadata['date'])
            return start_date <= task_date <= end_date

    # Fallback to file modification time
    file_mtime = os.path.getmtime(archive_file_path)
    task_date = datetime.fromtimestamp(file_mtime)

    return start_date <= task_date <= end_date
```

### 3. Task Data Extraction

```python
def extract_task_data(archive_content):
    """
    Extract key information from an archive document.
    """
    data = {
        'task_id': None,
        'task_name': None,
        'level': None,
        'completion_date': None,
        'summary': None,
        'key_changes': [],
        'lessons_learned': [],
        'challenges': [],
        'referenced_lessons': []
    }

    # Parse metadata section (## METADATA)
    metadata = extract_section(archive_content, "METADATA")
    if metadata:
        data['task_id'] = extract_field(metadata, "Task ID")
        data['level'] = extract_field(metadata, "Complexity Level")
        data['completion_date'] = extract_field(metadata, "Completion Date")

    # Extract task name from title (# TASK ARCHIVE: [Name])
    data['task_name'] = extract_title(archive_content)

    # Extract summary (## SUMMARY)
    data['summary'] = extract_section(archive_content, "SUMMARY")

    # Extract implementation/key changes (## IMPLEMENTATION or ## KEY CHANGES)
    implementation = extract_section(archive_content, "IMPLEMENTATION")
    if implementation:
        data['key_changes'] = extract_bullet_points(implementation, max=5)

    # Extract lessons (## LESSONS LEARNED)
    lessons = extract_section(archive_content, "LESSONS LEARNED")
    if lessons:
        data['lessons_learned'] = extract_bullet_points(lessons)

    # Extract challenges from corresponding reflection
    # (Read reflection-[task_id].md if exists)

    return data
```

### 4. New Lessons Detection

```python
def find_new_lessons(start_date, end_date):
    """
    Find lessons created within the date range.
    """
    new_lessons = []

    # Scan all lesson files
    lesson_files = glob('memory-bank/lessons/**/*.md', recursive=True)

    for file_path in lesson_files:
        # Skip templates and index
        if '_templates' in file_path or '_index.md' in file_path:
            continue

        content = read_file(file_path)
        lessons = parse_lesson_entries(content)

        for lesson in lessons:
            # Check Effectiveness metadata for "Created: YYYY-MM-DD"
            if lesson.get('effectiveness', {}).get('created'):
                created_date = parse_date(lesson['effectiveness']['created'])

                if start_date <= created_date <= end_date:
                    new_lessons.append({
                        'module': extract_module_name(file_path),
                        'id': lesson['id'],  # e.g., "L001"
                        'title': lesson['title'],
                        'created': created_date,
                        'file': file_path
                    })

    return new_lessons
```

### 5. Lesson Usage Tracking

```python
def analyze_lesson_usage(archived_tasks):
    """
    Track which lessons were referenced and their effectiveness.
    """
    usage = {}

    for task in archived_tasks:
        # Look for "Relevant Lessons Referenced" section in task archive
        lessons_section = extract_section(task['content'], "RELEVANT LESSONS REFERENCED")

        if lessons_section:
            # Parse lesson references: lessons/module.md#L001
            references = parse_lesson_references(lessons_section)

            for ref in references:
                key = f"{ref['module']}.md#{ref['lesson_id']}"

                if key not in usage:
                    usage[key] = {
                        'module': ref['module'],
                        'lesson_id': ref['lesson_id'],
                        'title': ref.get('title', ''),
                        'count': 0,
                        'effectiveness': []
                    }

                usage[key]['count'] += 1

                # Try to find effectiveness assessment in reflection
                reflection = find_reflection_for_task(task['task_id'])
                if reflection:
                    assessment = extract_lesson_assessment(reflection, ref['lesson_id'])
                    if assessment:
                        usage[key]['effectiveness'].append(assessment)

    return usage
```

## 📝 Report Formatting Rules

### Section Ordering
1. Title and metadata
2. Weekly overview (statistics)
3. Completed tasks list
4. Lessons and insights
5. Key achievements
6. Challenges
7. Lesson usage statistics
8. Ongoing work
9. Next week planning (template)
10. Reflection and improvements
11. Statistics and charts
12. Links

### Formatting Guidelines

**Dates**: Use YYYY-MM-DD format consistently

**Task Names**:
- Include level in parentheses: `(Level 3)`
- Use title case
- Keep concise (max 80 chars)

**Bullet Points**:
- Use `-` for unordered lists
- Use `1.` for ordered lists
- Max 3-5 points per section to maintain conciseness

**Tables**:
- Use markdown tables for structured data
- Align columns properly
- Include headers

**Links**:
- Use relative paths: `../archive/archive-task-001.md`
- Format: `[Display Text](path)`

### Statistics Calculation

**Task Distribution**:
```python
def calculate_task_distribution(tasks):
    total = len(tasks)
    by_level = {1: 0, 2: 0, 3: 0, 4: 0}

    for task in tasks:
        level = task['level']
        by_level[level] = by_level.get(level, 0) + 1

    return {
        'total': total,
        'by_level': {
            level: {
                'count': count,
                'percentage': round(count / total * 100, 1) if total > 0 else 0
            }
            for level, count in by_level.items()
        }
    }
```

**Success Rate**:
```python
def calculate_success_rate(effectiveness_list):
    """
    Calculate success rate from effectiveness assessments.
    Values: "Helpful", "Partially Helpful", "Not Helpful"
    """
    if not effectiveness_list:
        return "N/A"

    helpful = effectiveness_list.count("Helpful")
    partially = effectiveness_list.count("Partially Helpful")
    total = len(effectiveness_list)

    # Weight: Helpful=1.0, Partially=0.5, Not Helpful=0
    score = (helpful * 1.0 + partially * 0.5) / total * 100

    return f"{round(score)}%"
```

